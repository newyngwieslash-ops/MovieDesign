{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MovieDesign",
  "version": "0.1.0",
  "identifier": "io.github.newyngwieslash-ops.moviedesign",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -File ../scripts/frontend.ps1 -Mode dev",
    "beforeBuildCommand": "powershell -NoProfile -File ../scripts/frontend.ps1 -Mode build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "MovieDesign", "width": 1280, "height": 840, "minWidth": 760, "minHeight": 560, "backgroundColor": "#111315" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:8001; media-src 'self' http://127.0.0.1:8001; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8001; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:8001; media-src 'self' http://127.0.0.1:8001; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8001 ws://localhost:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/open-design-gateway", "binaries/moviedesign-opencode"],
    "resources": { "../../docs/third-party.md": "licenses/third-party.md", "binaries/media/": "media/", "../../agent/skills/": "skills/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0OUVGNDc0NkZBNkU2RDcKUldUWDVxWnZkUFNlcERHV2cyYno4bjZBclFuQk13Z1FLMWdlVm9zb3JjYkx6Y3VuRCtLSitjWWUK",
      "endpoints": [
        "https://github.com/newyngwieslash-ops/MovieDesign/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
